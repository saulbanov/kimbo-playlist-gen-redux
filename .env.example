# Spotify: create an app at developer.spotify.com/dashboard.
# The redirect URI must be HTTPS or the 127.0.0.1 loopback - `localhost`
# is rejected for new apps. Add this exact URI to the app settings too.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Genius (discover only): free token at genius.com/api-clients
GENIUS_TOKEN=

# GetSongBPM (enrich only): free key at getsongbpm.com/api.
# Their terms require a visible link back to getsongbpm.com wherever
# you publish their data.
GETSONGBPM_KEY=
